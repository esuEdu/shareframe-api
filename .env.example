SHAREFRAME_ENV=development
LOG_LEVEL=info

HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=15s
# Peers whose X-Forwarded-For may be believed. Empty trusts nobody.
HTTP_TRUSTED_PROXIES=

DATABASE_URL=postgres://shareframe:shareframe@localhost:5432/shareframe?sslmode=disable

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=2m

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback

SESSION_COOKIE_NAME=sf_session
SESSION_SECRET=
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false
# Exact paths a post-login return_to may point at. Anything else is ignored.
SESSION_RETURN_TO=/
